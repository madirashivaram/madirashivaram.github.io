{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000"],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance":    ["warn", {"minScore": 0.5}],
        "categories:accessibility":  ["warn", {"minScore": 0.8}],
        "categories:best-practices": ["warn", {"minScore": 0.8}],
        "categories:seo":            ["warn", {"minScore": 0.8}],
        "color-contrast":                    ["warn", {"minScore": 0}],
        "uses-responsive-images":            ["warn", {"maxLength": 5}],
        "modern-image-formats":              ["warn", {"maxLength": 5}],
        "render-blocking-resources":         ["warn", {"maxLength": 5}],
        "render-blocking-insight":           ["warn", {"maxLength": 5}],
        "network-dependency-tree-insight":   ["warn", {"minScore": 0}],
        "robots-txt":                        ["error", {"minScore": 1}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
